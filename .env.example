# Copy this file to .env and fill in real values.
# .env itself is gitignored and must never be committed.

GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# For temporary LAN access (e.g. demoing to someone on the same
# WiFi), add your laptop's LAN IPv4 address (find it with `ipconfig`
# on Windows, look for the active Wi-Fi/Ethernet adapter's "IPv4
# Address"), and set DEBUG=False before anyone else connects:
#   ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.100
#   DEBUG=False
# Never use a public IP, VPN IP, or a wildcard ("*") here.

# For a public Render deployment, set both of these to Render's
# assigned domain (shown after first deploy, e.g. my-app.onrender.com):
#   ALLOWED_HOSTS=my-app.onrender.com
#   CSRF_TRUSTED_ORIGINS=https://my-app.onrender.com
# CSRF_TRUSTED_ORIGINS is only needed for the public deployment (HTTPS,
# different from the plain-HTTP LAN case above) -- leave it blank
# for local development and LAN demos.
CSRF_TRUSTED_ORIGINS=

# LLM provider selection. "ollama" (default) = local development,
# unchanged Phase 1-20 behavior. "online_gemma" = Google AI Studio's
# hosted Gemma API, used for the Render deployment where Ollama
# cannot run. See ai_engine/services/model_config.py for details.
LLM_PROVIDER=ollama
ONLINE_GEMMA_API_KEY=
ONLINE_GEMMA_MODEL=gemma-3-4b-it

# Generate your own: python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#%^&*(-_=+)') for _ in range(50)))"
SECRET_KEY=

# Email (registration / verification). Leave EMAIL_BACKEND unset to use
# Django's console backend (prints emails to the runserver terminal --
# fine for local development, no real email is sent). To send real
# email, set:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@ai-recruitment.local
